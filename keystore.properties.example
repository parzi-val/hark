# Copy this file to `keystore.properties` (gitignored) and fill in real values.
#
# 1. Generate a release keystore (do this once, keep it + the passwords SAFE —
#    losing them means you can never ship an update to the same app):
#
#      keytool -genkeypair -v -keystore hark-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias hark
#
# 2. Put hark-release.jks at the repo root (it is gitignored) and fill in below.
#
# storeFile is resolved relative to the repo root.
storeFile=hark-release.jks
storePassword=CHANGE_ME
keyAlias=hark
keyPassword=CHANGE_ME
